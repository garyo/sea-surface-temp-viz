{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sst-viz-nightly-trigger",
  "account_id": "97571a833a50d387280ecaac7d736c4e",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  // Ticks every 10 minutes, 13:00–15:50 UTC (Cloudflare cron is UTC).
  // src/index.ts decides which tick dispatches: the first after NOAA posts the
  // day's OISST (~13:31), or the 15:30 deadline without it.
  "triggers": { "crons": ["*/10 13-15 * * *"] },
  "vars": {
    "GITHUB_REPO": "garyo/sea-surface-temp-viz",
    "WORKFLOW_FILE": "make-images.yml"
  }
  // Secret, set with `bunx wrangler secret put GITHUB_TOKEN`: a fine-grained
  // PAT scoped to this repo with "Actions: Read and write".
}
